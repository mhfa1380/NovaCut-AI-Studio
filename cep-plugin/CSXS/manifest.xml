<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="10.0" ExtensionBundleId="com.novacut.premiere.bridge" ExtensionBundleVersion="2.0.0" ExtensionBundleName="NovaCut AI Studio Bridge">
  <ExtensionList>
    <Extension Id="com.novacut.premiere.bridge.panel" Version="2.0.0"/>
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="PPRO" Version="[14.0,99.9]"/>
    </HostList>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="10.0"/>
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.novacut.premiere.bridge.panel">
      <DispatchInfo Host="PPRO">
        <Resources>
          <MainPath>./index.html</MainPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>NovaCut AI Studio</Menu>
          <Geometry>
            <Size>
              <Height>650</Height>
              <Width>380</Width>
            </Size>
            <MinSize>
              <Height>450</Height>
              <Width>320</Width>
            </MinSize>
            <MaxSize>
              <Height>2400</Height>
              <Width>2400</Width>
            </MaxSize>
          </Geometry>
          <Icons/>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
